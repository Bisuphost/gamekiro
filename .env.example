# Copy to .env and fill in for local development. Never commit the real .env.

DJANGO_SETTINGS_MODULE=gamekiro.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres. Falls back to local sqlite in dev.py if unset.
DATABASE_URL=postgres://gamekiro:gamekiro@localhost:5432/gamekiro

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0

# Media storage (prod only — Cloudflare R2, S3-compatible)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_PUBLIC_DOMAIN=

# Error tracking (optional)
SENTRY_DSN=
