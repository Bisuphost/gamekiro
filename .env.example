# Copy to .env and fill in for local development. Never commit the real .env.

DJANGO_SETTINGS_MODULE=gamekiro.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Admin site path. Defaults to admin/ if unset. In production, set this to an
# unguessable value (e.g. staff-portal-8f2c1a/) so the path itself isn't public.
DJANGO_ADMIN_URL=admin/

# Postgres. Falls back to local sqlite in dev.py if unset.
DATABASE_URL=postgres://gamekiro:gamekiro@localhost:5432/gamekiro

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0

# Media storage (prod only — Cloudflare R2, S3-compatible)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_PUBLIC_DOMAIN=

# Error tracking (optional)
SENTRY_DSN=

# Outbound email (prod only — console backend used everywhere else)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@gamekiro.local

# Canonical site URL, used to build absolute links in emails
SITE_URL=http://localhost:8000

# Prod-only: origins allowed to send unsafe (POST) requests, e.g. https://gamekiro.com
CSRF_TRUSTED_ORIGINS=

# --- Marketplace -------------------------------------------------------------
MARKETPLACE_ENABLED=False
MARKETPLACE_CURRENCY=USD
# Fernet key for encrypting game-key plaintext at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes every stored key permanently unrecoverable — back it up.
MARKETPLACE_KEY_ENC_KEY=
MARKETPLACE_SUPPORT_EMAIL=support@gamekiro.local
MARKETPLACE_USE_CELERY=False
# Must stay >= 35: Stripe Checkout sessions cannot expire sooner than 30 minutes.
MARKETPLACE_RESERVATION_TTL_MINUTES=35
# Dev/CI only. Production must run PostgreSQL — see marketplace/checks.py.
MARKETPLACE_ALLOW_SQLITE=False

# Comma-separated payment providers customers may choose at checkout. "mock" is
# honoured only in dev settings (MARKETPLACE_ALLOW_MOCK), never in production.
# Real providers additionally need their per-provider switch in the store dashboard.
PAYMENT_PROVIDERS_ENABLED=

# Stripe. Use a restricted key (rk_...) limited to Checkout Sessions and Refunds,
# and the signing secret(s) of the webhook endpoint https://<site>/store/webhooks/stripe/.
# Several comma-separated secrets are accepted so a secret can be rotated without downtime.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRETS=
# Leave empty to use the API version pinned by the installed stripe library.
STRIPE_API_VERSION=

# PayPal (REST app credentials + the ID of the webhook registered for
# https://<site>/store/webhooks/paypal/). PAYPAL_ENV is "sandbox" or "live".
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# --- Marketplace fraud & abuse controls ---------------------------------------
# Number of reverse proxies in front of this app that append to
# X-Forwarded-For (each one trusted to overwrite what the client sent, never
# to merely append after it). 0 means "don't trust that header at all, use the
# TCP peer address" — the safe default. Only raise this if you've confirmed
# your actual proxy chain (e.g. cPanel's Apache, or Apache behind Cloudflare).
MARKETPLACE_TRUSTED_PROXY_COUNT=0
# Require a buyer to confirm their email (a signed, time-limited link) before
# they can check out. Recommended on for launch; set False only for local/dev
# convenience.
MARKETPLACE_REQUIRE_VERIFIED_EMAIL=True
# 0 disables any of these three limits.
MARKETPLACE_MAX_ORDERS_PER_DAY=20
MARKETPLACE_MAX_PAYMENT_FAILURES=5
MARKETPLACE_PAYMENT_FAILURE_COOLDOWN_MINUTES=30
# Orders at/above this total, or a user's first order at/above the smaller
# threshold, are held as NEEDS_REVIEW after payment instead of auto-delivering
# keys; staff release them with the existing "Re-drive fulfilment" action.
MARKETPLACE_HIGH_VALUE_REVIEW_MINOR=20000
MARKETPLACE_FIRST_ORDER_REVIEW_MINOR=5000
MARKETPLACE_WEBHOOK_MAX_BODY_BYTES=262144
